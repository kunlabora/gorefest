# /etc/gorefest/env: owned by root, mode 0640, group gorefest. Never commit the real one.
GOREFEST_ENV=prod
BASE_URL=https://gorefest.example.org
# Long random string: `openssl rand -base64 48`. Changing it logs everyone out and kills invite links.
SECRET_KEY=
HOST=127.0.0.1
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/gorefest
DATABASE_USER=gorefest
DATABASE_PASSWORD=

# postmark or resend
MAIL_PROVIDER=postmark
MAIL_API_KEY=
MAIL_FROM=Gorefest <hello@gorefest.example.org>

# From your registered application on boardgamegeek.com
BGG_TOKEN=

# Nightly backups (deploy/backup.sh): an rclone remote and a libpq connection string
BACKUP_REMOTE=backups:gorefest
BACKUP_DATABASE_URI=postgresql://gorefest:PASSWORD@localhost:5432/gorefest
