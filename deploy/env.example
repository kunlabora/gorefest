# /etc/gorefest/env: owned by root, mode 0640, group gorefest. Never commit the real one.
# provision.sh fills BASE_URL, SECRET_KEY, DATABASE_PASSWORD and MAIL_FROM for you.
GOREFEST_ENV=prod
BASE_URL=https://gorefest.example.org
# Long random string. Changing it logs everyone out and kills invite links.
SECRET_KEY=
HOST=127.0.0.1
PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/gorefest
DATABASE_USER=gorefest
DATABASE_PASSWORD=

# Mail: scaleway, postmark or resend. For Scaleway, MAIL_API_KEY is an IAM secret key that may send
# Transactional Email, and SCW_PROJECT_ID the project the TEM domain belongs to.
MAIL_PROVIDER=scaleway
MAIL_API_KEY=
MAIL_FROM=Gorefest <hello@gorefest.example.org>
SCW_PROJECT_ID=

# From your registered application on boardgamegeek.com. Empty: the app runs with BGG switched off.
BGG_TOKEN=

# Nightly backups to Scaleway Object Storage (deploy/backup.sh). rclone reads its remote from these.
BACKUP_REMOTE=scaleway:gorefest-backups
BACKUP_DATABASE_URI=postgresql://gorefest:PASSWORD@localhost:5432/gorefest
RCLONE_CONFIG_SCALEWAY_TYPE=s3
RCLONE_CONFIG_SCALEWAY_PROVIDER=Scaleway
RCLONE_CONFIG_SCALEWAY_REGION=fr-par
RCLONE_CONFIG_SCALEWAY_ENDPOINT=s3.fr-par.scw.cloud
RCLONE_CONFIG_SCALEWAY_ACL=private
RCLONE_CONFIG_SCALEWAY_ACCESS_KEY_ID=
RCLONE_CONFIG_SCALEWAY_SECRET_ACCESS_KEY=
