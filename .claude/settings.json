{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/scw/**)",
      "Bash(cat:*.env*)",
      "Bash(env)",
      "Bash(printenv:*)"
    ]
  }
}
