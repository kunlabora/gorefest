{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gorefest",
      "runtimeExecutable": "java",
      "runtimeArgs": [
        "--sun-misc-unsafe-memory-access=allow",
        "-jar",
        "build/libs/gorefest.jar"
      ],
      "port": 8080
    },
    {
      "name": "docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "jwebserver --port 8765 --bind-address 127.0.0.1 --directory \"$PWD\""
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "jwebserver --port 8766 --bind-address 127.0.0.1 --directory \"$PWD/build/site\""
      ],
      "port": 8766
    },
    {
      "name": "gorefest-review",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        "run",
        "--quiet"
      ],
      "port": 8081,
      "env": {
        "PORT": "8081",
        "BASE_URL": "http://localhost:8081",
        "DATABASE_URL": "jdbc:postgresql://localhost:5432/gorefest_review"
      }
    }
  ]
}